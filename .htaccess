AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# pages de libellés : adresses sans extension, servies comme du HTML
<FilesMatch "^(Anniversaire|Cocarde|Concours|Eleveur|Exposition|Jalna|Santé|chaton|diplôme|début|femelle|pawpeds|race|snowshoe|études)$">
ForceType text/html
</FilesMatch>

<IfModule mod_headers.c>
Header append Vary User-Agent
</IfModule>

# copie de travail (tout autre nom de domaine que snowshoe.fr, par exemple snowshoe.bilan-mdph.fr) : jamais indexee
SetEnvIf Host "^(www\.)?snowshoe\.fr$" SITE_REEL=1
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow" env=!SITE_REEL
</IfModule>
RewriteEngine On
RewriteCond %{HTTP_HOST} !^(www\.)?snowshoe\.fr$ [NC]
RewriteRule ^robots\.txt$ robots-ferme.txt [L]
# une seule adresse pour le site : sans www
RewriteCond %{HTTP_HOST} ^www\.snowshoe\.fr$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(\S*)
RewriteRule ^ https://snowshoe.fr%1 [R=301,L]
# HTTPS : toute visite en http://snowshoe.fr est renvoyee vers https://snowshoe.fr (certificat OVH actif depuis le 28/10/2026)
RewriteCond %{HTTP_HOST} ^snowshoe\.fr$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(\S*)
RewriteRule ^ https://snowshoe.fr%1 [R=301,L]

# version téléphone : même adresse, deux présentations (comme Blogger)
# téléphone = ?m=1, ou navigateur de téléphone sans ?m=0
RewriteEngine On
RewriteRule ^ - [E=ISMOB:0]
RewriteCond %{HTTP_USER_AGENT} (iPhone|iPod|Android.*Mobile|Windows\ Phone|BlackBerry|Opera\ Mini|IEMobile) [NC]
RewriteCond %{QUERY_STRING} !(^|&)m=0(&|$)
RewriteRule ^ - [E=ISMOB:1]
RewriteCond %{QUERY_STRING} (^|&)m=1(&|$)
RewriteRule ^ - [E=ISMOB:1]
RewriteCond %{ENV:ISMOB} 1
RewriteRule ^$ m/index.html [L]
RewriteCond %{ENV:ISMOB} 1
RewriteRule ^((?:20[0-9][0-9]/|p/|search/label/).+)$ m/$1 [L]
